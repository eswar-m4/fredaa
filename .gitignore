# Backend logs and databases (contain user data — never commit)
backend/logs/*
backend/app.db
backend/*.db
backend/data/freda.db
backend/data/*.db
backend/data/backups/
backend/data/chrome-cdp/
backend/data/chrome-cdp-live/
# Runtime bot package artifacts (generated at runtime)
backend/data/bot_packages/
# Same database, root-level location (app can also be run from repo root)
data/*.db

# Regenerable extraction cache (not source data)
backend/datasets/.review_cache/

# IDE / Editor configurations
