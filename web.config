<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!--
      ARR reverse-proxy must be enabled at the IIS server level (locked there):
        IIS Manager → server node → Application Request Routing Cache
          → Server Proxy Settings → Enable proxy → Apply
      Do NOT add a <proxy> block here — those attributes are locked at server
      level and will cause a 500 config-lock error if set at site level.
    -->

    <rewrite>
      <rules>

        <!-- All traffic goes through the freda-auth gateway (port 8133).
             The gateway handles auth, then proxies:
               market users  /api/* → port 8131 (FastAPI backend)
               market users  /*     → port 8130 (Nitro SSR frontend)
               customer users /*    → port 8132 (customer portal) -->
        <rule name="freda-auth-gateway" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8133/{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <!-- Allow large file uploads (100 MB) to reach the backend -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- Let backend/frontend error responses pass through without IIS rewriting them -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
