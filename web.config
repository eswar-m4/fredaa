<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!--
      ARR reverse-proxy must be enabled at the IIS server level (locked there):
        IIS Manager → server node → Application Request Routing Cache
          → Server Proxy Settings → Enable proxy → Apply
      Do NOT add a <proxy> block here — those attributes are locked at server
      level and will cause a 500 config-lock error if set at site level.
    -->

    <rewrite>
      <rules>

        <!-- 1. FastAPI backend: API calls, Swagger UI, OpenAPI schema -->
        <rule name="Backend API" stopProcessing="true">
          <match url="^(api|docs|redoc|openapi\.json)(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8131/{R:0}" />
        </rule>

        <!-- 2. React SPA / Nitro SSR frontend -->
        <rule name="Frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8130/{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <!-- Allow large file uploads (100 MB) to reach the backend -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- Let backend/frontend error responses pass through without IIS rewriting them -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
