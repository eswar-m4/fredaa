# F.R.E.D.A Environment Configuration Template
# Copy this file to .env and update values for your environment

# Application
APP_NAME=F.R.E.D.A
APP_VERSION=0.3.0

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Logging
LOG_LEVEL=INFO

# Upload Constraints
MAX_UPLOAD_SIZE_MB=100

# Supported Formats (future use)
SUPPORTED_FORMATS=csv,xlsx,pdf,txt,docx

# AI/LLM Configuration
# OpenAI is used for By Dataset CDE enrichment; Gemini remains for legacy paths.
LOVABLE_API_KEY=your_lovable_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SEC=30

# Groq provider fallback configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.ai/v1
GROQ_MODEL=llama3-70b-8192

# Auth — REQUIRED in production; change before first run
# Generate a strong random salt: python -c "import secrets; print(secrets.token_hex(32))"
FREDA_AUTH_SALT=replace-with-a-long-random-string

# Initial seeded account passwords — set before first run to auto-create accounts.
# Remove or leave blank to skip auto-creation (users must be added via admin API).
FREDA_DEFAULT_USER_PASS=change-me-user
FREDA_DEFAULT_ADMIN_PASS=change-me-admin
