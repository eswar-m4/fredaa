# Required for LLM answers. OpenAI-compatible providers also work via FREDA_LLM_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternatives (used if OPENAI_API_KEY is empty)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Any OpenAI-compatible endpoint (Ollama, vLLM, Azure, LiteLLM, etc.)
# FREDA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FREDA_LLM_API_KEY=ollama
# FREDA_LLM_MODEL=llama3.1

# Live Freda (Mythili-freda) API — submitted requirements are created here.
# FREDA_PRODUCT_API_URL=http://127.0.0.1:8080
