# F.R.E.D.A Environment Configuration Template
# Copy this file to .env and update values for your environment

# Application
APP_NAME=F.R.E.D.A
APP_VERSION=0.3.0

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Logging
LOG_LEVEL=INFO

# Upload Constraints
MAX_UPLOAD_SIZE_MB=100

# Supported Formats (future use)
SUPPORTED_FORMATS=csv,xlsx,pdf,txt,docx

# AI/LLM Configuration (Phase 3) - Using Google Gemini Flash (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SEC=30

# Groq provider fallback configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.ai/v1
GROQ_MODEL=llama3-70b-8192
